<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorPrimary"
    android:layoutDirection="ltr">

    <include
        android:id="@+id/phone_open_on_car_strip"
        layout="@layout/phone_open_on_car_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/phone_header_divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@null"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phone_open_on_car_strip" />

    <me.aap.fermata.ui.view.FermataNavBarView
        android:id="@+id/nav_bar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:labelVisibilityMode="selected"
        app:layout_constraintBottom_toTopOf="@id/phone_bottom_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phone_header_divider"
        app:layout_constraintVertical_weight="1"
        app:position="LEFT" />

    <me.aap.fermata.ui.view.FermataToolBarView
        android:id="@+id/tool_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/body_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/nav_bar"
        app:layout_constraintTop_toBottomOf="@id/phone_header_divider" />

    <me.aap.fermata.ui.view.BodyLayout
        android:id="@+id/body_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:colorBackground"
        app:layout_constraintBottom_toTopOf="@id/phone_bottom_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/nav_bar"
        app:layout_constraintTop_toBottomOf="@id/tool_bar"
        app:layout_constraintVertical_weight="1" />

    <View
        android:id="@+id/control_panel_scrim"
        android:layout_width="0dp"
        android:layout_height="@dimen/control_panel_scrim_height"
        android:background="@drawable/control_panel_video_scrim"
        android:clickable="false"
        android:translationZ="3dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/phone_bottom_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_bar" />

    <me.aap.fermata.ui.view.ControlPanelView
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="@dimen/control_panel_height"
        android:translationZ="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/phone_bottom_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/nav_bar" />

    <me.aap.fermata.ui.view.FermataFloatingButton
        android:id="@+id/floating_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:translationY="-76dp"
        android:alpha="0.5"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/phone_bottom_menu"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@id/phone_bottom_menu"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/phone_bottom_menu_bg"
        android:theme="@style/PhoneBottomMenuThemeOverlay"
        android:visibility="gone"
        app:elevation="8dp"
        app:itemIconTint="@color/aa_nav_icon_tint"
        app:itemTextColor="@color/aa_nav_icon_tint"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/phone_bottom_menu" />

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/content_loading_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar" />

    <me.aap.utils.ui.menu.OverlayMenuView
        android:id="@+id/tool_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar"
        app:layout_constraintVertical_bias="0" />

    <me.aap.utils.ui.menu.OverlayMenuView
        android:id="@+id/context_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <me.aap.utils.ui.menu.OverlayMenuView
        android:id="@+id/control_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:translationY="-76dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1" />

    <me.aap.utils.ui.menu.OverlayMenuView
        android:id="@+id/nav_menu_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_bar"
        app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
