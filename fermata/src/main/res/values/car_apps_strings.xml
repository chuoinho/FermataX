    <string name="car_apps_guide_title">How to use Phone Apps</string>
    <string name="car_apps_guide_got_it">Got it</string>
    <string name="car_apps_guide_open_title">Open it on the car</string>
    <string name="car_apps_guide_open_body">On the car screen, open Addons, then Phone Apps.</string>
    <string name="car_apps_guide_drawer_title">App drawer</string>
    <string name="car_apps_guide_drawer_body">It lists the apps on your phone. Tap one to open it on the car screen.</string>
    <string name="car_apps_guide_keyboard_title">Keyboard</string>
    <string name="car_apps_guide_keyboard_body">Tap a text field in an app and the keyboard opens on the car screen.</string>
    <string name="car_apps_guide_buttons_title">Back and App drawer buttons</string>
    <string name="car_apps_guide_buttons_body">Back goes back in the app. App drawer returns to the list of apps. Hold App drawer to close an app that does not respond.</string>
    <string name="car_apps_guide_screen_title">Phone screen</string>
    <string name="car_apps_guide_screen_body_dark">While Phone Apps runs, the phone screen goes dark. The Turn off phone screen button turns it off again. Press the power key to use the phone.</string>
    <string name="car_apps_guide_screen_body_sleep">While Phone Apps runs, the phone can sleep as usual; the apps keep running on the car. Press the power key to use the phone.</string>
    <string name="car_apps_guide_wifi_title">Leaving Wi‑Fi</string>
    <string name="car_apps_guide_wifi_body">Phone Apps keeps working after you leave Wi‑Fi. After the phone restarts, connect to Wi‑Fi once so it can start again.</string>
    <string name="car_apps_guide_off_title">Turning it off</string>
    <string name="car_apps_guide_off_body">Use the switch in Settings &gt; Addons &gt; Phone Apps. Turned off, the apps stop.</string>
    <string name="car_apps_guide_report_title">Reporting a problem</string>
    <string name="car_apps_guide_report_body">In Settings &gt; Diagnostics, turn on Detailed diagnostics, repeat the problem, then tap Share Phone Apps report.</string>
