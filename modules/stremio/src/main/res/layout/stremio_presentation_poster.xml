<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_margin="4dp"
	android:background="@drawable/stremio_poster_focus_background"
	android:clickable="true"
	android:focusable="true"
	android:minWidth="96dp"
	android:padding="4dp">

	<com.google.android.material.imageview.ShapeableImageView
		android:id="@+id/stremio_presentation_poster_image"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:contentDescription="@null"
		android:scaleType="centerCrop"
		app:layout_constraintDimensionRatio="2:3"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:shapeAppearanceOverlay="@style/StremioPosterImageShape" />

	<com.google.android.material.progressindicator.LinearProgressIndicator
		android:id="@+id/stremio_presentation_poster_progress"
		android:layout_width="0dp"
		android:layout_height="4dp"
		android:max="1000"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="@id/stremio_presentation_poster_image"
		app:layout_constraintEnd_toEndOf="@id/stremio_presentation_poster_image"
		app:layout_constraintStart_toStartOf="@id/stremio_presentation_poster_image" />

	<TextView
		android:id="@+id/stremio_presentation_poster_title"
		android:layout_width="0dp"
		android:layout_height="40dp"
		android:layout_marginTop="7dp"
		android:ellipsize="end"
		android:fontFamily="sans-serif"
		android:gravity="center_horizontal|top"
		android:maxLines="2"
		android:paddingStart="2dp"
		android:paddingEnd="2dp"
		android:textAlignment="center"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:textSize="13sp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/stremio_presentation_poster_image" />
</androidx.constraintlayout.widget.ConstraintLayout>
