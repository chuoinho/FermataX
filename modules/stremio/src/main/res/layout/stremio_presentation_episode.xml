<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginStart="8dp"
	android:layout_marginTop="4dp"
	android:layout_marginEnd="8dp"
	android:layout_marginBottom="4dp"
	android:background="@drawable/stremio_presentation_card_background"
	android:clickable="true"
	android:focusable="true"
	android:minHeight="88dp"
	android:padding="8dp">

	<ImageView
		android:id="@+id/stremio_presentation_episode_thumbnail"
		android:layout_width="128dp"
		android:layout_height="72dp"
		android:contentDescription="@null"
		android:scaleType="centerCrop"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<com.google.android.material.progressindicator.LinearProgressIndicator
		android:id="@+id/stremio_presentation_episode_progress"
		android:layout_width="128dp"
		android:layout_height="4dp"
		android:max="1000"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="@id/stremio_presentation_episode_thumbnail"
		app:layout_constraintStart_toStartOf="@id/stremio_presentation_episode_thumbnail" />

	<TextView
		android:id="@+id/stremio_presentation_episode_number"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_marginStart="8dp"
		android:gravity="center"
		android:maxLines="1"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:textStyle="bold"
		app:layout_constraintStart_toEndOf="@id/stremio_presentation_episode_thumbnail"
		app:layout_constraintTop_toTopOf="parent" />

	<TextView
		android:id="@+id/stremio_presentation_episode_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:ellipsize="end"
		android:maxLines="2"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:textStyle="bold"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toEndOf="@id/stremio_presentation_episode_number"
		app:layout_constraintTop_toTopOf="@id/stremio_presentation_episode_number" />

	<TextView
		android:id="@+id/stremio_presentation_episode_metadata"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:layout_marginTop="2dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:textAppearance="?android:attr/textAppearanceSmall"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="@id/stremio_presentation_episode_title"
		app:layout_constraintTop_toBottomOf="@id/stremio_presentation_episode_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
