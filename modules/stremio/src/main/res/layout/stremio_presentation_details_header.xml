<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:padding="8dp">

	<ImageView
		android:id="@+id/stremio_presentation_details_backdrop"
		android:layout_width="0dp"
		android:layout_height="176dp"
		android:alpha="0.36"
		android:contentDescription="@null"
		android:scaleType="centerCrop"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<ImageView
		android:id="@+id/stremio_presentation_details_poster"
		android:layout_width="@dimen/stremio_presentation_details_poster_width"
		android:layout_height="0dp"
		android:layout_marginStart="8dp"
		android:contentDescription="@null"
		android:scaleType="centerCrop"
		app:layout_constraintBottom_toBottomOf="@id/stremio_presentation_details_backdrop"
		app:layout_constraintDimensionRatio="2:3"
		app:layout_constraintStart_toStartOf="@id/stremio_presentation_details_backdrop"
		app:layout_constraintTop_toTopOf="@id/stremio_presentation_details_backdrop" />

	<TextView
		android:id="@+id/stremio_presentation_details_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:layout_marginTop="12dp"
		android:layout_marginEnd="8dp"
		android:ellipsize="end"
		android:maxLines="2"
		android:textAppearance="?android:attr/textAppearanceLarge"
		android:textStyle="bold"
		app:layout_constraintEnd_toEndOf="@id/stremio_presentation_details_backdrop"
		app:layout_constraintStart_toEndOf="@id/stremio_presentation_details_poster"
		app:layout_constraintTop_toTopOf="@id/stremio_presentation_details_backdrop" />

	<TextView
		android:id="@+id/stremio_presentation_details_metadata"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:textAppearance="?android:attr/textAppearanceSmall"
		app:layout_constraintEnd_toEndOf="@id/stremio_presentation_details_title"
		app:layout_constraintStart_toStartOf="@id/stremio_presentation_details_title"
		app:layout_constraintTop_toBottomOf="@id/stremio_presentation_details_title" />

	<LinearLayout
		android:id="@+id/stremio_presentation_details_actions"
		android:layout_width="wrap_content"
		android:layout_height="48dp"
		android:layout_marginTop="8dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		app:layout_constraintStart_toStartOf="@id/stremio_presentation_details_title"
		app:layout_constraintTop_toBottomOf="@id/stremio_presentation_details_metadata">

		<ImageButton
			android:id="@+id/stremio_presentation_details_watch"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:focusable="true"
			android:padding="11dp"
			app:tint="?android:attr/textColorPrimary" />

		<ImageButton
			android:id="@+id/stremio_presentation_details_favorite"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:focusable="true"
			android:padding="11dp"
			app:tint="?android:attr/textColorPrimary" />

		<Button
			android:id="@+id/stremio_presentation_details_subtitles"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:background="?android:attr/selectableItemBackground"
			android:minWidth="0dp"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:textAllCaps="false"
			android:focusable="true"
			android:text="@string/stremio_presentation_subtitles" />
	</LinearLayout>

	<TextView
		android:id="@+id/stremio_presentation_details_overview"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:ellipsize="end"
		android:maxLines="3"
		android:textAppearance="?android:attr/textAppearanceSmall"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/stremio_presentation_details_backdrop" />
</androidx.constraintlayout.widget.ConstraintLayout>
