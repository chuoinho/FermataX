<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="20dp"
		android:paddingTop="8dp"
		android:paddingEnd="20dp"
		android:paddingBottom="8dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:labelFor="@id/stremio_source_url"
			android:text="@string/stremio_source_url"
			android:textAppearance="?android:attr/textAppearanceMedium" />

		<EditText
			android:id="@+id/stremio_source_url"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:autofillHints=""
			android:hint="@string/stremio_source_url_hint"
			android:imeOptions="actionNext"
			android:inputType="textUri|textNoSuggestions"
			android:maxLines="2"
			android:minHeight="56dp"
			android:selectAllOnFocus="true" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:labelFor="@id/stremio_source_token"
			android:text="@string/stremio_source_token"
			android:textAppearance="?android:attr/textAppearanceMedium" />

		<EditText
			android:id="@+id/stremio_source_token"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:autofillHints=""
			android:hint="@string/stremio_source_token_hint"
			android:imeOptions="actionDone"
			android:inputType="textPassword|textNoSuggestions"
			android:maxLines="1"
			android:minHeight="56dp"
			android:selectAllOnFocus="true" />

		<CheckBox
			android:id="@+id/stremio_source_allow_http"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center_vertical"
			android:minHeight="48dp"
			android:text="@string/stremio_source_allow_http" />

		<CheckBox
			android:id="@+id/stremio_source_allow_lan"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:minHeight="48dp"
			android:text="@string/stremio_source_allow_lan" />

		<TextView
			android:id="@+id/stremio_source_form_error"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="#FFFF6B6B"
			android:textStyle="bold"
			android:visibility="gone" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:paddingBottom="8dp"
			android:text="@string/stremio_source_consent_note"
			android:textAppearance="?android:attr/textAppearanceSmall" />
	</LinearLayout>
</ScrollView>
