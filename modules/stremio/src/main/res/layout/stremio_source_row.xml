<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/stremio_source_row"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="6dp"
	android:background="@drawable/stremio_source_row_background"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:minHeight="88dp"
	android:orientation="horizontal"
	android:paddingStart="8dp"
	android:paddingEnd="4dp">

	<ImageView
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:contentDescription="@null"
		android:padding="10dp"
		android:src="@drawable/stremio_source_provider"
		android:tint="?android:attr/textColorPrimary" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:layout_weight="1"
		android:orientation="vertical"
		android:paddingTop="6dp"
		android:paddingBottom="6dp">

		<TextView
			android:id="@+id/stremio_source_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/stremio_source_summary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?android:attr/textAppearanceSmall" />

		<TextView
			android:id="@+id/stremio_source_capabilities"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="2"
			android:textAppearance="?android:attr/textAppearanceSmall"
			android:textColor="?android:attr/textColorSecondary" />
	</LinearLayout>

	<CheckBox
		android:id="@+id/stremio_source_enabled"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:buttonTint="?android:attr/textColorPrimary"
		android:contentDescription="@string/stremio_source_enabled"
		android:gravity="center" />

	<ImageView
		android:id="@+id/stremio_source_more"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:background="?android:attr/selectableItemBackgroundBorderless"
		android:clickable="true"
		android:contentDescription="@string/stremio_source_more_actions"
		android:focusable="true"
		android:padding="14dp"
		android:src="@drawable/stremio_source_more"
		android:tint="?android:attr/textColorSecondary" />

	<ImageView
		android:id="@+id/stremio_source_drag_handle"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:background="?android:attr/selectableItemBackgroundBorderless"
		android:clickable="true"
		android:contentDescription="@string/stremio_source_reorder"
		android:focusable="true"
		android:padding="14dp"
		android:src="@drawable/stremio_source_drag"
		android:tint="?android:attr/textColorSecondary" />
</LinearLayout>
